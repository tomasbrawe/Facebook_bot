ANTHROPIC_API_KEY=your_anthropic_api_key_here
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Export cookies from Facebook while logged in using the Cookie-Editor browser extension.
# Click "Export" -> "Export as JSON" and paste the full array below (one line),
# e.g. [{"name":"c_user","value":"123456789",...},{"name":"xs","value":"abc123...",...}]
# A "Header String" export ("c_user=123; xs=abc...") also works.
FB_COOKIES=[{"name":"c_user","value":"123456789"},{"name":"xs","value":"abc123..."}]
